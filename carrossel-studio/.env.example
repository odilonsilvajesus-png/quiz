# Copie para .env e preencha. Sem as chaves, o sistema roda em modo demonstração.

# GPT / OpenAI (escreve a copy): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# YouTube Data API v3 (gratuita): https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Apify (coleta do Instagram, pago por uso): https://console.apify.com/settings/integrations
APIFY_TOKEN=

# Postar direto no Instagram: as imagens sobem para o ImgBB (grátis) antes de irem para o Instagram.
# Chave em https://api.imgbb.com/ . O ID e o token de cada cliente são cadastrados no painel.
IMGBB_API_KEY=

# Opcionais
# OPENAI_MODEL=gpt-5.5
# Imagens (usam a mesma OPENAI_API_KEY). Qualidade: low, medium ou high.
# IMAGEM_MODELO=gpt-image-2
# IMAGEM_QUALIDADE=medium
# Transcrição da fala dos reels (usa a mesma OPENAI_API_KEY)
# TRANSCRICAO_MODELO=gpt-4o-transcribe
# Para usar o Claude no lugar do GPT: preencha ANTHROPIC_API_KEY e IA_PROVEDOR=anthropic
# ANTHROPIC_API_KEY=
# IA_PROVEDOR=openai
# PORTA=3333
# CHROMIUM_PATH=/caminho/do/chrome   (por padrão usa o Google Chrome instalado)

# Custos em reais (opcional). Por padrão usa o dólar PTAX do Banco Central, atualizado sozinho.
# COTACAO_DOLAR=5.30
# IOF da compra internacional no cartão, em %. Use 0 se pagar as APIs sem IOF.
# IOF_PERCENTUAL=3.5
