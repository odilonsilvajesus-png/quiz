# Porta do servidor da API
PORT=3001

# ElevenLabs — clone de voz + narração (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# HeyGen — avatar/clone em vídeo com sincronização labial (https://app.heygen.com/settings?nav=API)
HEYGEN_API_KEY=
# Altura máxima pedida ao HeyGen (planos menores só liberam 720)
HEYGEN_MAX_HEIGHT=1080

# Sem as chaves acima a plataforma roda em MODO DEMO (voz silenciosa + foto animada),
# útil para testar legendas, edição e download sem gastar créditos.
